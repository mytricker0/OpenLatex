# Copy to deploy/.env (gitignored) and fill in. `docker compose` in deploy/
# reads it automatically. Compose refuses to start if the :? vars are unset.

# --- Required ---

# Absolute host path to the data directory (the parent of openlatex/, mongo/,
# redis/). Must be absolute: the per-compile sibling containers bind-mount
# $OPENLATEX_DATA_DIR/openlatex/data/{compiles,output} and the docker daemon
# needs the real host path. Example: /srv/openlatex/data
OPENLATEX_DATA_DIR=/srv/openlatex/data

# Secrets — generate each with: openssl rand -base64 32
OVERLEAF_INVITE_TOKEN_SECRET=
SESSION_SECRET=

# --- Optional (sensible defaults in docker-compose.yml) ---

# Sandboxed compiles. Default true. REQUIRES gVisor on the host:
#   sudo bash develop/bin/install-gvisor.sh
# Set to false to fall back to unsandboxed CE compiles (keep registration
# invite-only if you do).
#SANDBOXED_COMPILES=true

# Per-compile runtime. Default runsc (gVisor). Could be sysbox-runc if installed.
#DOCKER_RUNTIME=runsc

# Compile image. Pin to a digest in production for reproducibility + CVE control:
#   TEXLIVE_IMAGE=texlive/texlive@sha256:<digest>
#TEXLIVE_IMAGE=texlive/texlive:latest-small

# uid the compile runs as inside the sandbox (non-root). Default 1000.
#TEXLIVE_IMAGE_USER=1000
